{
  "name": "@mfcd/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var ENVIRONMENT:development --var DEV_ADMIN_EMAIL:dev@localhost",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-types": "wrangler types --strict-vars=false",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mfcd/shared": "workspace:*",
    "hono": "4.13.14",
    "jose": "6.2.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
