{
  "name": "medical-frailty-dashboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @mfcd/web build && concurrently -k -n web,api -c blue,magenta \"pnpm --filter @mfcd/web build --watch\" \"pnpm --filter @mfcd/api dev\"",
    "dev:stop": "node scripts/dev-stop.ts",
    "build": "pnpm --filter @mfcd/web build && pnpm --filter @mfcd/api build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "pnpm --filter @mfcd/web build && pnpm --filter @mfcd/web e2e",
    "check": "node scripts/check.ts",
    "check:full": "node scripts/check.ts --full",
    "cf": "node scripts/cf.ts",
    "db:generate": "pnpm --filter @mfcd/api db:generate",
    "db:migrate:local": "pnpm --filter @mfcd/api db:migrate:local",
    "db:ref:local": "pnpm --filter @mfcd/reference-data build && pnpm --filter @mfcd/reference-data load --local",
    "db:seed:make": "node scripts/make-seed.ts",
    "db:seed:local": "node scripts/seed.ts --env local",
    "db:seed:preview": "node scripts/seed.ts --env preview",
    "db:drift": "node scripts/db-drift.ts",
    "deploy:preview": "pnpm --filter @mfcd/web build && node scripts/cf.ts deploy --env preview"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1"
  }
}
