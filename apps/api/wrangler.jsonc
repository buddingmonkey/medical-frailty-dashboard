// Cloudflare Worker: serves the Vue build (apps/web/dist) and the API.
// Top level = production. `--env preview` = the preview Worker. See docs/deployment.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "frailty-dashboard",
  "main": "src/index.ts",
  // Matches the workerd bundled with wrangler and @cloudflare/vitest-plugin, so tests, dev and
  // production share runtime behaviour. Raise it when the pool package catches up.
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // No per-version URLs: no unprotected copy of the site may exist.
  "preview_urls": false,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request runs the Worker first, so security headers (and, from step 5, the site
    // gate) apply to static files too. At go-live, /assets/* moves to direct serving; see
    // docs/deployment.md, "Going live".
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Search terms stay out of logs.
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true },
  },
  // SITE_MODE: anything but "public" keeps the whole site behind Access (fail closed).
  // ACCESS_TEAM_DOMAIN and ACCESS_AUD are Worker secrets, not vars: CI uploads them with each
  // deploy from GitHub environment variables (docs/deployment.md). While unset, every gated
  // request gets a 401.
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_MODE": "private",
  },
  // database_id values are placeholders for local dev and tests. CI writes the real id from the
  // GitHub environment variable D1_DATABASE_ID (scripts/d1-ids.ts); `pnpm cf` uses the ids in
  // apps/api/.env.cloudflare. So a new host deploys without editing this file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frailty-prod",
      "database_id": "local-frailty-prod",
      // SQL from drizzle-kit (src/db/schema.ts) plus hand-written ones (FTS5). CI applies them
      // before each deploy (roadmap M1 step 6).
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "frailty-prod-files" }],
  // Public API rate limits per client IP (src/middleware/rate-limit.ts, docs/security.md).
  // Counted per Cloudflare location, approximately. namespace_id is any integer unique in the
  // account; preview uses its own so the two Workers never share counters. Not inherited, so
  // preview repeats them below.
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  // Weekly maintenance, Sunday 07:00 UTC: full dump to R2, backup pruning, draft cleanup
  // (src/maintenance). Triggers are not inherited, so preview repeats it below.
  "triggers": { "crons": ["0 7 * * SUN"] },
  // The deployed version's id: part of every public cache key, so a deploy never serves pages
  // or JSON cached by the previous code (src/middleware/public-cache.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "env": {
    "preview": {
      "name": "frailty-dashboard-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "SITE_MODE": "private",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "frailty-preview",
          "database_id": "local-frailty-preview",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "frailty-preview-files" }],
      "ratelimits": [
        {
          "name": "PUBLIC_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "SEARCH_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      "triggers": { "crons": ["0 7 * * SUN"] },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
    },
  },
}
