{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "erasableSyntaxOnly": true,
    // Scripts run directly on Node (type stripping), which needs `./x.ts` in imports.
    "allowImportingTsExtensions": true
  },
  "include": ["*.js", "*.ts", "scripts/**/*.ts"]
}
