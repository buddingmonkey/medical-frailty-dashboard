{
  "name": "@mfcd/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var ENVIRONMENT:development --var DEV_ADMIN_EMAIL:dev@localhost",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-types": "wrangler types --strict-vars=false",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@mfcd/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hono": "4.13.16",
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "drizzle-kit": "0.31.11",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
